{
  "ConnectionStrings": {
    "DefaultConnection": "Host=YOUR_DB_HOST;Database=YOUR_DB_NAME;Username=YOUR_DB_USER;Password=YOUR_DB_PASSWORD;SSL Mode=Require;Trust Server Certificate=true"
  },
  "Jwt": {
    "Key": "CHANGE_THIS_TO_A_256_BIT_SECRET_KEY_MINIMUM_32_CHARACTERS_LONG",
    "Issuer": "SIMS-API",
    "Audience": "SIMS-Client",
    "AccessTokenExpiryMinutes": 15,
    "RefreshTokenExpiryDays": 7
  },
  "Storage": {
    "AzureBlobConnectionString": "DefaultEndpointsProtocol=https;AccountName=YOUR_ACCOUNT_NAME;AccountKey=YOUR_ACCOUNT_KEY;EndpointSuffix=core.windows.net",
    "AzureBlobContainerName": "documents",
    "MaxFileSizeBytes": 52428800
  },
  "Syncfusion": {
    "LicenseKey": "YOUR_SYNCFUSION_COMMUNITY_LICENSE_KEY"
  },
  "MicrosoftAuth": {
    "TenantId": "YOUR_AZURE_TENANT_ID",
    "ClientId": "YOUR_AZURE_CLIENT_ID"
  },
  "AllowedOrigins": [ "http://localhost:5173", "http://localhost:5174" ],
  "AllowedHosts": "*",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  }
}
